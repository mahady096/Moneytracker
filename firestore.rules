rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    match /users/{uid} {
      allow read, write: if signedInAs(uid);

      match /institutions/{id} {
        allow read, delete: if signedInAs(uid);
        allow create, update: if signedInAs(uid)
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 100;
      }
      match /accounts/{id} {
        allow read, delete: if signedInAs(uid);
        allow create, update: if signedInAs(uid)
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.balance is int
          && request.resource.data.balance >= -9000000000000000
          && request.resource.data.balance <= 9000000000000000;
      }
      match /scheduled/{id} {
        allow read, delete: if signedInAs(uid);
        allow create, update: if signedInAs(uid)
          && request.resource.data.name is string
          && request.resource.data.amount is int
          && request.resource.data.amount > 0
          && request.resource.data.next is string
          && request.resource.data.freq in ['weekly', 'monthly', 'quarterly', 'yearly'];
      }
      match /budgets/{id} {
        allow read, delete: if signedInAs(uid);
        allow create, update: if signedInAs(uid)
          && request.resource.data.limit is int
          && request.resource.data.limit > 0;
      }
      match /categories/{id} {
        allow read, delete: if signedInAs(uid);
        allow create, update: if signedInAs(uid)
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 60;
      }
      match /debts/{id} {
        allow read, delete: if signedInAs(uid);
        allow create, update: if signedInAs(uid)
          && request.resource.data.person is string
          && request.resource.data.amount is int && request.resource.data.amount > 0
          && request.resource.data.paid is int && request.resource.data.paid >= 0\n          && request.resource.data.paid <= request.resource.data.amount;
      }
      match /goals/{id} {
        allow read, delete: if signedInAs(uid);
        allow create, update: if signedInAs(uid)
          && request.resource.data.name is string
          && request.resource.data.target is int && request.resource.data.target > 0
          && request.resource.data.saved is int && request.resource.data.saved >= 0\n          && request.resource.data.saved <= request.resource.data.target;
      }
      match /records/{id} {
        allow read, delete: if signedInAs(uid);
        allow create, update: if signedInAs(uid)
          && request.resource.data.amount is int
          && request.resource.data.amount > 0
          && request.resource.data.type in ['income', 'expense', 'transfer']
          && request.resource.data.accountId is string
          && request.resource.data.date is timestamp;
      }
    }
  }
}