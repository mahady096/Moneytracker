rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    match /users/{uid} {
      allow read, write: if signedInAs(uid);


      match /cloudBackups/{backupId} {
        allow read, write: if signedInAs(uid);
        match /chunks/{chunkId} {
          allow read, write: if signedInAs(uid);
        }
      }
      match /institutions/{id} {
        allow read, delete: if signedInAs(uid);
        allow create, update: if signedInAs(uid)
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 100;
      }
      match /accounts/{id} {
        allow read, delete: if signedInAs(uid);
        allow create, update: if signedInAs(uid)
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.balance is int
          && request.resource.data.balance >= -9000000000000000
          && request.resource.data.balance <= 9000000000000000;
      }
      match /scheduled/{id} {
        allow read, delete: if signedInAs(uid);
        allow create, update: if signedInAs(uid)
          && request.resource.data.name is string
          && request.resource.data.amount is int
          && request.resource.data.amount > 0
          && request.resource.data.next is string
          && request.resource.data.freq in ['weekly', 'monthly', 'quarterly', 'yearly'];
      }
      match /budgets/{id} {
        allow read, delete: if signedInAs(uid);
        allow create, update: if signedInAs(uid)
          && request.resource.data.limit is int
          && request.resource.data.limit > 0;
      }
      match /categories/{id} {
        allow read, delete: if signedInAs(uid);
        allow create, update: if signedInAs(uid)
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 60;
      }
      match /debts/{id} {
        allow read, delete: if signedInAs(uid);
        allow create, update: if signedInAs(uid)
          && request.resource.data.person is string
          && request.resource.data.amount is int && request.resource.data.amount > 0
          && request.resource.data.paid is int && request.resource.data.paid >= 0
          && request.resource.data.paid <= request.resource.data.amount;
      }
      match /goals/{id} {
        allow read, delete: if signedInAs(uid);
        allow create, update: if signedInAs(uid)
          && request.resource.data.name is string
          && request.resource.data.target is int && request.resource.data.target > 0
          && request.resource.data.saved is int && request.resource.data.saved >= 0
          && request.resource.data.saved <= request.resource.data.target;
      }
      match /records/{id} {
        allow read, delete: if signedInAs(uid);
        allow create, update: if signedInAs(uid)
          && request.resource.data.amount is int
          && request.resource.data.amount > 0
          && request.resource.data.type in ['income', 'expense', 'transfer']
          && request.resource.data.accountId is string
          && request.resource.data.date is timestamp;
      }
    }

    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    match /admins/{id} {
      allow get: if request.auth != null && request.auth.uid == id;
      allow list, write: if false;
    }
    match /site/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin()
        && request.resource.data.notice is string && request.resource.data.notice.size() <= 300
        && request.resource.data.slides is list && request.resource.data.slides.size() <= 10;
    }
    match /profiles/{id} {
      allow get: if request.auth != null && (request.auth.uid == id || isAdmin());
      allow list: if isAdmin();
      allow create: if request.auth != null && request.auth.uid == id
        && request.resource.data.keys().hasOnly(['email','createdAt','lastSeen','blocked','note','appVersion'])
        && request.resource.data.blocked == false;
      allow update: if (request.auth != null && request.auth.uid == id
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeen','email','appVersion'])) || isAdmin();
      allow delete: if (request.auth != null && request.auth.uid == id) || isAdmin();
    }
    match /messages/{id} {
      allow read: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000
        && request.resource.data.status == 'new'
        && !(exists(/databases/$(database)/documents/profiles/$(request.auth.uid)) && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.blocked == true)
        && request.resource.data.keys().hasOnly(['uid','email','text','status','createdAt']);
      allow update: if isAdmin();
      allow delete: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
    }
  }
}
